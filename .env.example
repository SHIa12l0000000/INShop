SUPABASE_URL=
SUPABASE_ANON_KEY=
# Configure GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET in Supabase provider settings.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
